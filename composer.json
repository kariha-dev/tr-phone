{
    "name": "kariha/tr-phone",
    "description": "PHP toolkit for validating, normalizing, parsing and formatting Turkish phone numbers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "turkey",
        "turkiye",
        "turkish",
        "phone",
        "phone-number",
        "telephone",
        "mobile",
        "gsm",
        "validation",
        "normalization",
        "formatter",
        "e164",
        "php"
    ],
    "homepage": "https://github.com/kariha-dev/tr-phone",
    "support": {
        "issues": "https://github.com/kariha-dev/tr-phone/issues",
        "source": "https://github.com/kariha-dev/tr-phone"
    },
    "authors": [
        {
            "name": "Kariha Web Agency",
            "homepage": "https://www.kariha.net/"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kariha\\TrPhone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kariha\\TrPhone\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "composer validate --strict",
            "@test",
            "@analyse",
            "@cs"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
